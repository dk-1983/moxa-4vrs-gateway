#!/bin/sh
# Install only as a reversible replacement of the verified vendor S40 entry.
# Recovery executable and CRC store are on UserDisk (/etc), NOT CompactFlash.
# The reviewed derivative retains vendor hooks and unowned interfaces. It
# replaces only the four ifup/ifdown -a calls with explicit unowned inventory.
if ! test -f /etc/4vrs-network/enabled; then
  exec /etc/4vrs-network/vendor-networking "$@"
fi
if ! test -x /etc/4vrs-network/vendor-networking-managed; then
  echo '4VRS: managed vendor script missing; networking action blocked' >&2
  exit 1
fi
case "$1" in
  start|restart|force-reload)
    /etc/4vrs-network/gateway-network-recovery --network-boot || exit 1
    /etc/4vrs-network/vendor-networking-managed "$@" || exit 1
    exec /etc/4vrs-network/gateway-network-recovery --network-owner-start
    ;;
  *) exec /etc/4vrs-network/vendor-networking-managed "$@" ;;
esac
