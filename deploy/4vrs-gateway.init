#!/bin/sh
# SysV-compatible candidate; install only under separate target authorization.
root=/var/hda/4vrs
binary=$root/bin/4vrs-gateway
pidfile=$root/run/4vrs-gateway.pid
disable=$root/disable-autostart
log=$root/log/startup.log
valid_pid(){ case "$1" in ''|0|*[!0-9]*) return 1;; *) return 0;; esac; }
is_ours(){ valid_pid "$1" && test -r "/proc/$1/exe" && test "/proc/$1/exe" -ef "$binary"; }
case "${1:-}" in
 start)
  test -e "$disable" && exit 0
  test -w "$root" || { echo "4vrs-gateway: storage is read-only" >&2; exit 1; }
  test -x "$binary" || { echo "4vrs-gateway: executable unavailable" >&2; exit 1; }
  mkdir -p "$root/run" "$root/log" || exit 1
  if test -r "$pidfile"; then read pid <"$pidfile"; is_ours "$pid" && exit 0; rm -f "$pidfile" || exit 1; fi
  if test -r /dev/console && test -w /dev/console; then
   "$binary" </dev/console >/dev/console 2>&1 &
  else
   "$binary" </dev/null >"$log" 2>&1 &
  fi
  pid=$!; tmp=$pidfile.tmp; echo "$pid" >"$tmp" && mv -f "$tmp" "$pidfile" || exit 1
  ;;
 stop)
  test -r "$pidfile" || exit 0; read pid <"$pidfile"
  is_ours "$pid" || { rm -f "$pidfile"; exit 0; }
  kill -TERM "$pid" || exit 1; count=0
  while kill -0 "$pid" 2>/dev/null && test "$count" -lt 50; do sleep 1; count=`expr "$count" + 1`; done
  kill -0 "$pid" 2>/dev/null && exit 1; rm -f "$pidfile"
  ;;
 status)
  test -r "$pidfile" || exit 3; read pid <"$pidfile"; is_ours "$pid" && exit 0; exit 1
  ;;
 *) echo "usage: $0 {start|stop|status}" >&2; exit 2;;
esac
exit 0
