{
  "name": "Moxa XScale compatibility environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": ["--platform=linux/amd64"]
  },
  "workspaceFolder": "/workspace/source",
  "workspaceMount": "source=moxa-serial-server-source,target=/workspace/source,type=volume,readonly",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace/source-host,type=bind,readonly",
    "source=moxa-xscale-toolchain,target=/usr/local/xscale_be,type=volume,readonly",
    "source=moxa-serial-server-build,target=/workspace/build,type=volume"
  ],
  "runArgs": [
    "--network=none",
    "--security-opt=no-new-privileges"
  ],
  "remoteUser": "root"
}
